{
  "entities": {
    "users": {
      "title": "User",
      "description": "Application users (student, parent, teacher, school_admin, counselor)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "parent", "teacher", "school_admin", "counselor"] },
        "organization": { "type": "string" },
        "creditsEarned": { "type": "number" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "students": {
      "title": "Student",
      "description": "Student wellness telemetry, profile, and engagement metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "grade": { "type": "string" },
        "avatar": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "notes": { "type": "string" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "moodScore": { "type": "number" },
        "stressLevel": { "type": "string", "enum": ["Low", "Moderate", "High"] },
        "gems": { "type": "number" },
        "creditsEarned": { "type": "number" },
        "streak": { "type": "number" },
        "level": { "type": "number" },
        "pinSet": { "type": "boolean" },
        "pin": { "type": "string" },
        "privacyLevel": { "type": "string", "enum": ["full", "summary"] },
        "consentToSchoolSharing": { "type": "boolean" }
      },
      "required": ["name", "age"]
    },
    "assessments": {
      "title": "Assessment",
      "description": "Periodic and progressive mental wellbeing assessments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "childId": { "type": "string" },
        "submittedBy": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "scores": {
          "type": "object",
          "properties": {
            "mood": { "type": "number" },
            "stress": { "type": "number" },
            "sleep": { "type": "number" },
            "behavior": { "type": "number" },
            "social": { "type": "number" },
            "energy": { "type": "number" }
          }
        },
        "totalScore": { "type": "number" },
        "aiInsight": { "type": "string" },
        "parentId": { "type": "string" }
      },
      "required": ["childId", "submittedBy", "timestamp", "scores"]
    },
    "alerts": {
      "title": "Alert",
      "description": "Behavioral alerts and crisis escalation notices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "childId": { "type": "string" },
        "parentId": { "type": "string" },
        "type": { "type": "string", "enum": ["critical", "warning", "info"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "resolved", "dismissed"] },
        "read": { "type": "boolean" }
      },
      "required": ["childId", "type", "title", "timestamp"]
    },
    "schoolSchedules": {
      "title": "School Schedule",
      "description": "Academic schedule and upcoming examination dates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "childId": { "type": "string" },
        "type": { "type": "string", "enum": ["class", "exam", "activity", "deadline", "assignment", "event"] },
        "title": { "type": "string" },
        "day": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] },
        "time": { "type": "string" },
        "subject": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "required": ["childId", "type", "title", "day", "time"]
    },
    "selfChecks": {
      "title": "Self Check",
      "description": "Student quick mood check-in and reflection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "childId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "mood": { "type": "number" },
        "note": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["childId", "timestamp", "mood"]
    },
    "triageCases": {
      "title": "Counselor Triage Case",
      "description": "Clinical counselor triage tracking for escalating student concerns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "in_progress", "resolved"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "assignedCounselorId": { "type": "string" },
        "notes": { "type": "string" },
        "followUpDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "status", "severity", "createdAt"]
    },
    "auditLogs": {
      "title": "Access Audit Log",
      "description": "Immutable log of student privacy record access and sharing events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "actorId": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string", "enum": ["view_summary", "view_assessment", "export_data", "consent_change", "delete_request"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "string" }
      },
      "required": ["studentId", "actorId", "actorRole", "action", "timestamp"]
    },
    "userPreferences": {
      "title": "User Preferences",
      "description": "Notification settings, quiet hours, and privacy preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "channels": {
          "type": "object",
          "properties": {
            "inApp": { "type": "boolean" },
            "email": { "type": "boolean" },
            "sms": { "type": "boolean" }
          }
        },
        "quietHours": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "startTime": { "type": "string" },
            "endTime": { "type": "string" }
          }
        },
        "criticalBypassQuietHours": { "type": "boolean" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile directory"
    },
    "/students/{childId}": {
      "schema": "students",
      "description": "Student wellness profiles"
    },
    "/assessments/{assessmentId}": {
      "schema": "assessments",
      "description": "Longitudinal student assessments"
    },
    "/notifications/{alertId}": {
      "schema": "alerts",
      "description": "Alerts and proactive notifications"
    },
    "/schoolSchedules/{scheduleId}": {
      "schema": "schoolSchedules",
      "description": "Academic timetable and exams"
    },
    "/selfChecks/{checkId}": {
      "schema": "selfChecks",
      "description": "Student self-reported mood checks"
    },
    "/triageCases/{caseId}": {
      "schema": "triageCases",
      "description": "Counselor triage management queue"
    },
    "/auditLogs/{logId}": {
      "schema": "auditLogs",
      "description": "Student privacy access audit trail"
    },
    "/userPreferences/{userId}": {
      "schema": "userPreferences",
      "description": "User notification and privacy preferences"
    }
  }
}
