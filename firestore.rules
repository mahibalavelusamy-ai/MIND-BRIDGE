rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Helper Functions & Relationship Validation
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : 'guest';
    }

    function isAdmin() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'admin' || role == 'school_admin');
    }

    function isCounselor() {
      let role = getUserRole();
      return isAuthenticated() && (role == 'counselor' || role == 'clinician');
    }

    function isTeacher() {
      let role = getUserRole();
      return isAuthenticated() && role == 'teacher';
    }

    function isTeacherOrClinicianOrCaretaker() {
      let role = getUserRole();
      return isAuthenticated() && (
        role == 'teacher' || 
        role == 'clinician' || 
        role == 'counselor' || 
        role == 'caretaker' || 
        role == 'parent' || 
        role == 'school_admin' || 
        role == 'admin'
      );
    }

    function isParentOf(studentId) {
      let studentPath = /databases/$(database)/documents/students/$(studentId);
      return isAuthenticated() && exists(studentPath) && get(studentPath).data.parentId == request.auth.uid;
    }

    function isAssignedCaretaker(studentId) {
      let relPath = /databases/$(database)/documents/relationships/$(request.auth.uid + '_' + studentId);
      return isAuthenticated() && exists(relPath);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Users Directory: Strictly isolated to owner, admin, or verified caretakers
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isTeacherOrClinicianOrCaretaker());
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Students Directory: Role & Relationship bound access (No blanket authenticated access)
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isOwner(studentId) ||
        resource.data.parentId == request.auth.uid ||
        isTeacherOrClinicianOrCaretaker() ||
        isAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.parentId == request.auth.uid ||
        isOwner(studentId) ||
        isTeacherOrClinicianOrCaretaker() ||
        isAdmin()
      );

      allow update: if isAuthenticated() && (
        isOwner(studentId) ||
        resource.data.parentId == request.auth.uid ||
        isTeacherOrClinicianOrCaretaker() ||
        isAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        isAdmin()
      );

      match /schedules/{scheduleId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/students/$(studentId)).data.parentId == request.auth.uid ||
          isOwner(studentId) ||
          isTeacherOrClinicianOrCaretaker()
        );
        allow create, update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/students/$(studentId)).data.parentId == request.auth.uid ||
          isOwner(studentId) ||
          isAdmin()
        );
      }
    }

    // Assessments: Scoped to student, parent, or assigned clinical staff
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.childId == request.auth.uid ||
        isTeacherOrClinicianOrCaretaker()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.parentId == request.auth.uid ||
        request.resource.data.childId == request.auth.uid ||
        isTeacherOrClinicianOrCaretaker()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.childId == request.auth.uid ||
        isTeacherOrClinicianOrCaretaker() ||
        isAdmin()
      );
    }

    // Notifications / Alerts: Verified recipient or clinical actor (No blanket writes)
    match /notifications/{alertId} {
      allow read: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.childId == request.auth.uid ||
        resource.data.childId == 'all' ||
        isTeacherOrClinicianOrCaretaker()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.parentId == request.auth.uid ||
        request.resource.data.childId == request.auth.uid ||
        isTeacherOrClinicianOrCaretaker() ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.childId == request.auth.uid ||
        isTeacherOrClinicianOrCaretaker() ||
        isAdmin()
      );
    }

    // Counselor Triage Queue: Counselors and School Admins only
    match /triageCases/{caseId} {
      allow read: if isAuthenticated() && (isCounselor() || isAdmin());
      allow create, update: if isAuthenticated() && (isCounselor() || isAdmin() || isTeacherOrClinicianOrCaretaker());
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Access Audit Log: Append-only by system / actor, readable by student and parent
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.actorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // User Notification & Privacy Preferences: Strictly owner-isolated
    match /userPreferences/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Relationships & Connection Requests
    match /relationships/{relId} {
      allow read: if isAuthenticated() && (resource.data.caretakerId == request.auth.uid || resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.caretakerId == request.auth.uid || request.resource.data.studentId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.caretakerId == request.auth.uid || resource.data.studentId == request.auth.uid || isAdmin());
    }
    
    match /connectionRequests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.caretakerId == request.auth.uid || resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.caretakerId == request.auth.uid || request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.caretakerId == request.auth.uid || resource.data.studentId == request.auth.uid);
    }

    // School Schedules
    match /schoolSchedules/{scheduleId} {
      allow read: if isAuthenticated() && (resource.data.parentId == request.auth.uid || resource.data.childId == request.auth.uid || isTeacherOrClinicianOrCaretaker());
      allow create, update, delete: if isAuthenticated() && (request.resource.data.parentId == request.auth.uid || isTeacherOrClinicianOrCaretaker() || isAdmin());
    }

    // Self Checks (Private reflections)
    match /selfChecks/{checkId} {
      allow read: if isAuthenticated() && (resource.data.parentId == request.auth.uid || resource.data.childId == request.auth.uid || isTeacherOrClinicianOrCaretaker());
      allow create: if isAuthenticated() && (request.resource.data.childId == request.auth.uid || request.resource.data.parentId == request.auth.uid || isTeacherOrClinicianOrCaretaker());
      allow update, delete: if isAuthenticated() && (resource.data.parentId == request.auth.uid || resource.data.childId == request.auth.uid || isAdmin());
    }

    // Supporting Analytics & Behavioral Telemetry collections
    match /rootCauseAnalyses/{analysisId} {
      allow read, write: if isAuthenticated() && (resource.data.parentId == request.auth.uid || isTeacherOrClinicianOrCaretaker());
    }
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || isTeacherOrClinicianOrCaretaker());
    }
    match /schedules/{scheduleId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || isTeacherOrClinicianOrCaretaker());
    }
    match /rewardRedemptions/{redemptionId} {
      allow read, write: if isAuthenticated() && (resource.data.parentId == request.auth.uid || isTeacherOrClinicianOrCaretaker());
    }
    match /emotional_stability/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /mental_resilience/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /silent_risk/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /trigger_map/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /intervention_effectiveness/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
